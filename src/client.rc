#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "client.manifest"

DLG_SETTINGS DIALOGEX 0, 0, 324, 180
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ntfy – Einstellungen"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Abonnements", -1, 12, 12, 214, 10
    LISTBOX     IDC_SUBSCRIPTIONS, 12, 26, 232, 92, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON  "Hinzufügen…", IDC_ADD, 252, 26, 60, 15
    PUSHBUTTON  "Bearbeiten…", IDC_EDIT, 252, 45, 60, 15
    PUSHBUTTON  "Entfernen", IDC_REMOVE, 252, 64, 60, 15
    LTEXT       "", IDC_STATUS, 12, 125, 300, 20
    DEFPUSHBUTTON "Speichern", IDC_SAVE, 184, 153, 60, 15
    PUSHBUTTON  "Schließen", IDCANCEL, 252, 153, 60, 15
END

DLG_SUBSCRIPTION DIALOGEX 0, 0, 272, 128
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ntfy – Abo"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "&Server-URL", -1, 12, 13, 76, 10
    EDITTEXT    IDC_SERVER, 92, 11, 168, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT       "&Topic", -1, 12, 34, 76, 10
    EDITTEXT    IDC_TOPIC, 92, 32, 168, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT       "&Token (optional)", -1, 12, 55, 76, 10
    EDITTEXT    IDC_TOKEN, 92, 53, 168, 14, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP
    LTEXT       "Für Abos mit Token ist HTTPS erforderlich.", -1, 92, 73, 168, 15
    DEFPUSHBUTTON "Übernehmen", IDOK, 132, 101, 60, 15
    PUSHBUTTON  "Abbrechen", IDCANCEL, 200, 101, 60, 15
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "ntfy Windows Client"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductName", "ntfy Windows Client"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
