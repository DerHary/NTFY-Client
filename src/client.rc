#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "client.manifest"

DLG_SETTINGS DIALOGEX 0, 0, 324, 327
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "NTFY Client – Settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX    "Notifications", -1, 12, 10, 300, 137
    LTEXT       "Show notifications as", -1, 22, 27, 94, 10
    COMBOBOX    IDC_DISPLAY_MODE, 122, 24, 180, 74, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT       "Notification sound", -1, 22, 51, 94, 10
    COMBOBOX    IDC_SOUND, 122, 48, 119, 110, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    PUSHBUTTON  "Preview", IDC_PREVIEW, 247, 47, 55, 17
    PUSHBUTTON  "Open sounds folder", IDC_OPEN_SOUNDS_FOLDER, 122, 68, 105, 17
    LTEXT       "Reminder theme", -1, 22, 99, 94, 10
    COMBOBOX    IDC_REMINDER_THEME, 122, 96, 180, 72, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT       "Test sample", -1, 22, 123, 94, 10
    COMBOBOX    IDC_TEST_LINK_COUNT, 122, 120, 84, 72, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    PUSHBUTTON  "Test notification", IDC_TEST_NOTIFICATION, 212, 119, 90, 17
    LTEXT       "Subscriptions", -1, 12, 159, 214, 10
    LISTBOX     IDC_SUBSCRIPTIONS, 12, 173, 232, 92, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON  "Add…", IDC_ADD, 252, 173, 60, 15
    PUSHBUTTON  "Edit…", IDC_EDIT, 252, 192, 60, 15
    PUSHBUTTON  "Remove", IDC_REMOVE, 252, 211, 60, 15
    LTEXT       "", IDC_STATUS, 12, 272, 300, 20
    DEFPUSHBUTTON "Save", IDC_SAVE, 184, 300, 60, 15
    PUSHBUTTON  "Close", IDCANCEL, 252, 300, 60, 15
END

DLG_SUBSCRIPTION DIALOGEX 0, 0, 272, 128
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "NTFY Client – Subscription"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "&Server URL", -1, 12, 13, 76, 10
    EDITTEXT    IDC_SERVER, 92, 11, 168, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT       "&Topic", -1, 12, 34, 76, 10
    EDITTEXT    IDC_TOPIC, 92, 32, 168, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT       "&Token (optional)", -1, 12, 55, 76, 10
    EDITTEXT    IDC_TOKEN, 92, 53, 168, 14, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP
    LTEXT       "A subscription with a token requires HTTPS.", -1, 92, 73, 168, 15
    DEFPUSHBUTTON "Apply", IDOK, 132, 101, 60, 15
    PUSHBUTTON  "Cancel", IDCANCEL, 200, 101, 60, 15
END

DLG_REMINDER DIALOGEX 0, 0, 270, 218
STYLE DS_SETFONT | WS_POPUP
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "NTFY Client"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "NTFY Client", IDC_REMINDER_BRAND, 28, 15, 75, 11
    RTEXT       "", IDC_REMINDER_QUEUE, 109, 15, 63, 11
    CONTROL     "Open link", IDC_REMINDER_OPEN_LINK, "Button", BS_OWNERDRAW | WS_TABSTOP | NOT WS_VISIBLE, 181, 10, 75, 19
    LTEXT       "", IDC_REMINDER_TITLE, 14, 32, 242, 20, SS_ENDELLIPSIS | SS_NOPREFIX
    LTEXT       "Remind in", -1, 14, 142, 135, 10
    COMBOBOX    IDC_REMINDER_UNIT, 14, 155, 75, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | CBS_OWNERDRAWFIXED | WS_TABSTOP | WS_VSCROLL
    COMBOBOX    IDC_REMINDER_AMOUNT, 95, 155, 45, 114, CBS_DROPDOWNLIST | CBS_HASSTRINGS | CBS_OWNERDRAWFIXED | WS_TABSTOP | WS_VSCROLL
    CONTROL     "Remind again", IDC_REMINDER_AGAIN, "Button", BS_OWNERDRAW | WS_TABSTOP, 153, 154, 103, 18
    LTEXT       "", IDC_REMINDER_ERROR, 14, 172, 242, 10
    CONTROL     "Close", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 14, 193, 57, 16
    LTEXT       "No further reminder", IDC_REMINDER_HINT, 79, 197, 177, 10
    CONTROL     "", IDC_REMINDER_TEXT, "RICHEDIT50W", WS_TABSTOP | WS_VSCROLL | ES_READONLY | ES_MULTILINE | ES_AUTOVSCROLL, 20, 63, 230, 65
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,2,3,0
PRODUCTVERSION 0,2,3,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "NTFY Client"
            VALUE "FileVersion", "0.2.3"
            VALUE "ProductName", "NTFY Client"
            VALUE "ProductVersion", "0.2.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
